{
  "name": "Global Cost Sheet",
  "short_name": "GCS",
  "description": "CPM project costing (Global Cost Sheet)",
  "id": "./index.html",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1e3a5f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/gcs": [
          ".gcs"
        ],
        "application/pcw": [
          ".pcw"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/gcs",
            ".gcs",
            "application/pcw",
            ".pcw"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+gcs",
      "url": "./index.html?pcw_url=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "New Cost Sheet",
      "short_name": "New",
      "description": "Start a new project costing",
      "url": "./index.html?action=new",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": [
    "business",
    "finance",
    "productivity"
  ]
}